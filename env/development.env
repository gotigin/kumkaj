# Kumkaj development / debug builds (cargo kumkaj-dev, cargo kumkaj-android-dev,
# cargo kumkaj-windows-dev). Sourced by scripts; also read by apps/kumkaj/build.rs
# via KUMKAJ_ENV=development.
KUMKAJ_ENV=development
KUMKAJ_APP_ID=com.kumkaj.app.debug
KUMKAJ_APP_LABEL="Kumkaj Dev"
KUMKAJ_SHOW_SIZE_BADGE=1
