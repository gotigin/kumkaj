{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kumkaj: live (--hot --remote)",
      "type": "shell",
      "command": "cargo",
      "args": ["kumkaj-dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
