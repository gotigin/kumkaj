# Rust / Cargo
/target/
**/target/
**/*.rs.bk
*.pdb

# Packaged builds (linux / windows / windows-dev / android / web / …)
/dist/

# Stray desktop binaries if dropped outside /dist/
*.exe
*.dll
*.apk
*.aab

# Makepad: fetched via scripts/setup-makepad.sh (do not commit the tree)
/vendor/makepad/
/vendor/makepad-full/
**/.makepad/

# Large CJK / emoji fonts — copied from vendor by fetch-ui-fonts / package scripts
/apps/kumkaj/resources/fonts/LXGWWenKai*.ttf
/apps/kumkaj/resources/fonts/NotoColorEmoji.ttf

# Local runtime / screenshots (not source)
/local/

# App / SQLite data (never commit live DBs or backups)
**/*.sqlite3
**/*.sqlite3-wal
**/*.sqlite3-shm
**/backups/

# Desktop window restore prefs (normally under the OS app-data dir)
**/window_geom.json

# Secrets / local env overrides (tracked templates live in env/*.env)
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.idea/
*.iml

# Optional: keep .vscode/tasks.json in git; ignore personal overrides
.vscode/*.code-workspace
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
