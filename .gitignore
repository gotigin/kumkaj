# Rust / Cargo
/target/
**/target/
**/*.rs.bk
*.pdb

# Packaged builds (linux / windows / windows-dev / android / web / …)
/dist/

# Stray desktop binaries if dropped outside /dist/
*.exe
*.dll
*.apk
*.aab

# Makepad: fetched via scripts/setup-makepad.sh (do not commit the tree)
/vendor/makepad/
/vendor/makepad-full/
**/.makepad/

# Microsoft MSIX SDK build (scripts/msix/ensure-makemsix.sh) + installed tool
/vendor/msix-packaging/
/tools/makemsix/

# Large CJK / emoji fonts — copied from vendor by fetch-ui-fonts / package scripts
/apps/moklanjo/resources/fonts/LXGWWenKai*.ttf
/apps/moklanjo/resources/fonts/NotoColorEmoji.ttf

# Local runtime / screenshots (not source)
/local/

# App / SQLite data (never commit live DBs or backups)
**/*.sqlite3
**/*.sqlite3-wal
**/*.sqlite3-shm
**/backups/

# Desktop window restore prefs (normally under the OS app-data dir)
**/window_geom.json

# Secrets / local env overrides (tracked templates live in env/*.env)
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.idea/
*.iml

# Optional: keep .vscode/tasks.json in git; ignore personal overrides
.vscode/*.code-workspace
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json

# Firebase Hosting local cache
.firebase/
**-debug.log

# Site npm trees (Firebase Analytics client) — bundle into static/js/
apps/*/web/node_modules/
sites/*/node_modules/

# Firebase Hosting staged public/ (Makepad wasm + static shell)
sites/*/public/
apps/khaynjo/web/public/

# Private catalogue packs (12-digit code paths) — publish locally, do not commit
sites/*/static/v1/catalogue/private/
# Synced from apps/*/assets/items by publish-catalogue.sh (do not duplicate in git)
sites/*/static/v1/catalogue/public/items/
