+/// Whitespace that may hang past the end of a row: every space except the
+/// no-break ones.
+fn is_hanging_space(c: char) -> bool {
+    c.is_whitespace() && !matches!(c, '\u{00A0}' | '\u{2007}' | '\u{202F}')
+}
+
+/// Whether the UAX #14 break opportunity before byte `index` of `text`
+/// survives the tailorings listed on `line_break_segments`.
+fn keeps_break(text: &str, index: usize) -> bool {
+    use unicode_linebreak::{break_property, BreakClass};
+
+    let class = |c: char| break_property(c as u32);
+    let is_hangul = |c: char| {
+        matches!(
+            class(c),
+            BreakClass::HangulLvSyllable
+                | BreakClass::HangulLvtSyllable
+                | BreakClass::HangulLJamo
+                | BreakClass::HangulVJamo
+                | BreakClass::HangulTJamo
+        )
+    };
+    let is_letter_or_digit = |c: char| {
+        is_hangul(c)
+            || matches!(
+                class(c),
+                BreakClass::Alphabetic | BreakClass::HebrewLetter | BreakClass::Numeric
+            )
+    };
+    let (before, after) = text.split_at(index);
+    let (Some(previous), Some(next)) = (before.chars().next_back(), after.chars().next()) else {
+        return true;
+    };
+    if (is_hangul(previous) && is_letter_or_digit(next))
+        || (is_letter_or_digit(previous) && is_hangul(next))
+    {
+        return false;
+    }
+    if !is_hanging_space(previous) {
+        return true;
+    }
+    // From here on the break follows one or more spaces.
+    let words_before = before.trim_end_matches(is_hanging_space);
+    let Some(solid) = words_before.chars().next_back() else {
+        return true;
+    };
+    if matches!(next, '\u{2013}' | '\u{2014}') {
+        return false;
+    }
+    if is_closing_quote(next) {
+        let after_quote = after[next.len_utf8()..].chars().next();
+        if after_quote.map_or(true, |c| {
+            c.is_whitespace()
+                || matches!(
+                    class(c),
+                    BreakClass::NonBreakingGlue
+                        | BreakClass::WordJoiner
+                        | BreakClass::ClosePunctuation
+                        | BreakClass::CloseParenthesis
+                        | BreakClass::Quotation
+                        | BreakClass::Exclamation
+                        | BreakClass::InfixSeparator
+                        | BreakClass::Symbol
+                        | BreakClass::ZeroWidthSpace
+                )
+        }) {
+            return false;
         }
     }
+    if is_opening_quote(solid) {
+        let before_quote = words_before[..words_before.len() - solid.len_utf8()]
+            .chars()
+            .next_back();
+        if before_quote.map_or(true, |c| {
+            c.is_whitespace()
+                || matches!(
+                    class(c),
+                    BreakClass::OpenPunctuation
+                        | BreakClass::Quotation
+                        | BreakClass::NonBreakingGlue
+                        | BreakClass::ZeroWidthSpace
+                )
+        }) {
+            return false;
+        }
+    }
+    let solid_class = class(solid);
+    let next_class = class(next);
+    if (solid_class == BreakClass::Prefix && next_class == BreakClass::Numeric)
+        || (solid_class == BreakClass::Numeric
+            && matches!(next_class, BreakClass::Prefix | BreakClass::Postfix))
+    {
+        return false;
+    }
+    true
 }
 
