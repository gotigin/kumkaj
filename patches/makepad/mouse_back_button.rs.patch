 pub fn from_mouse(button: u32) -> Option<MouseButton> {
-    // ref: linux/input-event-codes.h
+    // linux/input-event-codes.h. Most mice send the thumb "back" button as
+    // BTN_SIDE (0x113), not BTN_BACK (0x116). Unmapped codes were dropped,
+    // so the click never became a MouseDown.
     match button {
         0x110 => Some(MouseButton::PRIMARY),
         0x111 => Some(MouseButton::SECONDARY),
         0x112 => Some(MouseButton::MIDDLE),
-        0x116 => Some(MouseButton::BACK),
-        0x117 => Some(MouseButton::FORWARD),
+        0x113 | 0x116 | 8 => Some(MouseButton::BACK),
+        0x114 | 0x115 | 0x117 | 9 => Some(MouseButton::FORWARD),
         _ => None,
     }
 }
