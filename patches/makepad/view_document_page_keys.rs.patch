+    /// True when a TextInput under this view owns key focus (caret keys /
+    /// Space must stay with the field). Buttons that kept focus after a click
+    /// must not block document PageUp/Ctrl+A — browser chrome scrolls the page.
+    fn doc_text_field_owns_keys(&self, cx: &Cx) -> bool {
+        if cx.get_ime_area_rect().size.y > 0.0 {
+            return true;
+        }
+        let mut owns = false;
+        fn visit(w: &WidgetRef, cx: &Cx, owns: &mut bool) {
+            if *owns {
+                return;
+            }
+            if w.borrow::<TextInput>().is_some() && w.key_focus(cx) {
+                *owns = true;
+                return;
+            }
+            w.children(&mut |_, child| visit(&child, cx, owns));
+        }
+        for (_id, child) in &self.children {
+            visit(child, cx, &mut owns);
+        }
+        owns
+    }
+
+    fn doc_scroll_kind_for_key(ke: &KeyEvent) -> Option<DocScrollKind> {
+        match ke.key_code {
+            KeyCode::PageUp => Some(DocScrollKind::PageUp),
+            KeyCode::PageDown => Some(DocScrollKind::PageDown),
+            KeyCode::Home => Some(DocScrollKind::Home),
+            KeyCode::End => Some(DocScrollKind::End),
+            KeyCode::ArrowUp if !ke.modifiers.shift => Some(DocScrollKind::LineUp),
+            KeyCode::ArrowDown if !ke.modifiers.shift => Some(DocScrollKind::LineDown),
+            KeyCode::Space if !ke.modifiers.shift && !ke.modifiers.is_primary() => {
+                Some(DocScrollKind::PageDown)
+            }
+            KeyCode::Space if ke.modifiers.shift => Some(DocScrollKind::PageUp),
+            _ => None,
+        }
+    }
