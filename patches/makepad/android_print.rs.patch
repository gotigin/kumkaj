+/// App-facing wrappers used by Khaynjo/Moklanjo `print_android` (Option form).
+pub unsafe fn try_list_strings(method: &str, _sig: &str) -> Option<Vec<String>> {
+    match method {
+        "listBluetoothPrinters" => Some(to_java_list_bluetooth_printers()),
+        "listUsbPrinters" => Some(to_java_list_usb_printers()),
+        _ => Some(Vec::new()),
+    }
+}
+
+pub unsafe fn try_write_printer_bytes(
+    method: &str,
+    key: &str,
+    bytes: &[u8],
+) -> Option<Result<(), String>> {
+    let ok = match method {
+        "writeBluetoothSpp" => to_java_write_bluetooth_spp(key.to_owned(), bytes),
+        "writeUsbPrinter" => to_java_write_usb_printer(key.to_owned(), bytes),
+        _ => false,
+    };
+    if ok {
+        Some(Ok(()))
+    } else {
+        Some(Err(format!("{method} failed — is the printer paired/plugged and permitted?")))
+    }
+}
+
+pub unsafe fn try_print_document(job_name: &str, text: &str) -> Option<Result<(), String>> {
+    if to_java_print_document(job_name.to_owned(), text.to_owned()) {
+        Some(Ok(()))
+    } else {
+        Some(Err("Android PrintManager refused the job".into()))
+    }
+}
