+/// Kumkaj printers: paired Bluetooth devices as `bt:MAC` lines.
+pub unsafe fn to_java_list_bluetooth_printers() -> Vec<String> {
+    let env = attach_jni_env();
+    let result = ndk_utils::call_object_method!(
+        env,
+        get_activity(),
+        "listBluetoothPrinters",
+        "()[Ljava/lang/String;"
+    );
+    java_string_array_to_vec(env, result)
+}
+
+/// Kumkaj printers: write ESC/POS bytes over Bluetooth SPP.
+pub unsafe fn to_java_write_bluetooth_spp(mac: String, data: &[u8]) -> bool {
+    let env = attach_jni_env();
+    let Ok(mac) = CString::new(mac) else {
+        return false;
+    };
+    let mac = ((**env).NewStringUTF.unwrap())(env, mac.as_ptr());
+    let bytes = (**env).NewByteArray.unwrap()(env, data.len() as i32);
+    if bytes.is_null() {
+        return false;
+    }
+    (**env).SetByteArrayRegion.unwrap()(
+        env,
+        bytes,
+        0,
+        data.len() as i32,
+        data.as_ptr() as *const jni_sys::jbyte,
+    );
+    let ok = ndk_utils::call_bool_method!(
+        env,
+        get_activity(),
+        "writeBluetoothSpp",
+        "(Ljava/lang/String;[B)Z",
+        mac,
+        bytes
+    );
+    ok != 0
+}
