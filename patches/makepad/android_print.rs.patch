+/// Kumkaj printers: Standard slip via Android PrintManager (system print UI).
+pub unsafe fn to_java_print_document(job_name: String, text: String) -> bool {
+    let env = attach_jni_env();
+    let Ok(job_name) = CString::new(job_name) else {
+        return false;
+    };
+    let Ok(text) = CString::new(text) else {
+        return false;
+    };
+    let job_name = ((**env).NewStringUTF.unwrap())(env, job_name.as_ptr());
+    let text = ((**env).NewStringUTF.unwrap())(env, text.as_ptr());
+    let ok = ndk_utils::call_bool_method!(
+        env,
+        get_activity(),
+        "printDocument",
+        "(Ljava/lang/String;Ljava/lang/String;)Z",
+        job_name,
+        text
+    );
+    ok != 0
+}
