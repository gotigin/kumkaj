+    /// Height of the items drawn for the current range, in the list's flow
+    /// direction. Valid after `next_visible_item` returns `None`.
+    pub fn drawn_range_extent(&self) -> f64 {
+        let vi = self.vec_index;
+        self.draw_align_list
+            .iter()
+            .filter(|item| item.index >= self.range_start && item.index < self.range_end)
+            .map(|item| item.size.index(vi))
+            .sum()
+    }
