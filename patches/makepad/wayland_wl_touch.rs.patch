+    /// Alt+F4/F7/F8/F9/F10. These are the shortcuts a desktop binds to a title
+    /// bar. Returns whether this key was one of them.
+    fn client_window_shortcut(&mut self, key_code: KeyCode, serial: u32) -> bool {
+        let wid = match self.keyboard_window.or(self.pointer_window) {
+            Some(wid) => wid,
+            None => return false,
+        };
+        if !self.windows.iter().any(|w| w.window_id == wid) {
+            return false;
+        }
+        match key_code {
+            KeyCode::F4 => {
+                let accept_close = Rc::new(Cell::new(true));
+                self.do_callback(XlibEvent::WindowCloseRequested(WindowCloseRequestedEvent {
+                    window_id: wid,
+                    accept_close,
+                }));
+                true
+            }
+            KeyCode::F7 => {
+                if let Some(seat) = self.seat.as_ref() {
+                    if let Some(window) = self.windows.iter().find(|w| w.window_id == wid) {
+                        window.toplevel._move(seat, serial);
+                    }
+                }
+                true
+            }
+            KeyCode::F8 => {
+                let edge = self
+                    .windows
+                    .iter()
+                    .find(|w| w.window_id == wid)
+                    .and_then(|w| resize_edge_at(self.last_mouse_pos, w.window_geom.inner_size))
+                    .map(|(edge, _)| edge)
+                    .unwrap_or(xdg_toplevel::ResizeEdge::BottomRight);
+                if let Some(seat) = self.seat.as_ref() {
+                    if let Some(window) = self.windows.iter().find(|w| w.window_id == wid) {
+                        window.toplevel.resize(seat, serial, edge);
+                    }
+                }
+                true
+            }
+            KeyCode::F9 => {
+                if let Some(window) = self.windows.iter().find(|w| w.window_id == wid) {
+                    window.toplevel.set_minimized();
+                }
+                true
+            }
+            KeyCode::F10 => {
+                self.do_callback(XlibEvent::ChromeMaximizeToggle(wid));
+                true
+            }
+            _ => false,
+        }
+    }
