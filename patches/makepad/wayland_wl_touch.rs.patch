+    fn note_finger(&mut self, pos: Vec2d) {
+        self.last_finger = Some((self.time_now(), pos));
+    }
+
+    /// Primary pointer events that belong to a finger already delivered as touch.
+    fn finger_claims_pointer(&self, pos: Vec2d) -> bool {
+        if !self.touch_points.is_empty() || self.caption_touch.is_some() {
+            return true;
+        }
+        let Some((t, at)) = self.last_finger else {
+            return false;
+        };
+        self.time_now() - t < 0.3 && (at - pos).length() < 36.0
+    }
+
+    fn dismiss_popups_on_main_window(&mut self, window_id: WindowId) {
+        if self.windows.iter().any(|w| w.window_id == window_id) && !self.popups.is_empty() {
+            let popup_ids: Vec<_> = self.popups.iter().rev().map(|p| p.window_id).collect();
+            for popup_wid in popup_ids {
+                self.do_callback(XlibEvent::PopupDismissed(PopupDismissedEvent {
+                    window_id: popup_wid,
+                    reason: PopupDismissReason::OutsideClick,
+                }));
+            }
+        }
+    }
+
+    /// Edge resize, Alt-drag, and caption move use the touch-down serial.
+    /// Returns true when the finger must not also click a widget.
+    fn shell_takes_touch(&mut self, window_id: WindowId, pos: Vec2d, serial: u32, id: i32) -> bool {
+        let is_main = self.windows.iter().any(|w| w.window_id == window_id);
+        if !is_main {
+            return false;
+        }
+        let window_size = self
+            .windows
+            .iter()
+            .find(|w| w.window_id == window_id)
+            .map(|w| w.window_geom.inner_size);
+        if let Some(ws) = window_size {
+            if let Some((edge, _)) = resize_edge_at(pos, ws) {
+                if let (Some(seat), Some(window)) = (
+                    self.seat.as_ref(),
+                    self.windows.iter().find(|w| w.window_id == window_id),
+                ) {
+                    window.toplevel.resize(seat, serial, edge);
+                    return true;
+                }
+            }
+        }
+        if self.modifiers.alt {
+            if let (Some(seat), Some(window)) = (
+                self.seat.as_ref(),
+                self.windows.iter().find(|w| w.window_id == window_id),
+            ) {
+                window.toplevel._move(seat, serial);
+                return true;
+            }
+        }
+        let response = Rc::new(Cell::new(WindowDragQueryResponse::NoAnswer));
+        self.do_callback(XlibEvent::WindowDragQuery(WindowDragQueryEvent {
+            window_id,
+            abs: pos,
+            response: response.clone(),
+        }));
+        if matches!(response.get(), WindowDragQueryResponse::Caption) {
+            self.pending_caption_move = Some((serial, window_id, pos));
+            self.caption_touch = Some(id);
+            return true;
+        }
+        false
+    }
+
+    fn drag_caption_if_moved(&mut self, pos: Vec2d) {
+        let Some((serial, move_wid, start)) = self.pending_caption_move else {
+            return;
+        };
+        if (pos.x - start.x).abs() <= 8.0 && (pos.y - start.y).abs() <= 8.0 {
+            return;
+        }
+        if let (Some(seat), Some(window)) = (
+            self.seat.as_ref(),
+            self.windows.iter().find(|w| w.window_id == move_wid),
+        ) {
+            window.toplevel._move(seat, serial);
+        }
+        self.pending_caption_move = None;
+        self.caption_touch = None;
+        self.last_caption_click = None;
+    }
+
+    fn finish_caption_click(&mut self, wid: WindowId, pos: Vec2d) {
+        let now = self.time_now();
+        // A finger is less precise than a mouse double-click.
+        let is_double = self
+            .last_caption_click
+            .map(|(t, p, click_wid)| {
+                click_wid == wid && (now - t) < 0.35 && (pos - p).length() < 24.0
+            })
+            .unwrap_or(false);
+        if is_double {
+            self.last_caption_click = None;
+            self.do_callback(XlibEvent::ChromeMaximizeToggle(wid));
+        } else {
+            self.last_caption_click = Some((now, pos, wid));
+        }
+    }
+
+    fn queue_touch(&mut self, window_id: WindowId, id: i32, pos: Vec2d, touch_state: TouchState) {
+        let uid = u64::try_from(id).unwrap_or(0);
+        self.touch_frame.push((
+            window_id,
+            TouchPoint {
+                state: touch_state,
+                abs: pos,
+                time: self.time_now(),
+                uid,
+                rotation_angle: 0.0,
+                force: 1.0,
+                radius: dvec2(1.0, 1.0),
+                handled: Cell::new(Area::Empty),
+                sweep_lock: Cell::new(Area::Empty),
+            },
+        ));
+    }
+
+    fn emit_touch_frame(&mut self) {
+        let batch = std::mem::take(&mut self.touch_frame);
+        let time = self.time_now();
+        let modifiers = self.modifiers;
+        // One event per point, in order. A single TouchUpdate returns from
+        // the first hit, so a Down and Up in the same event would press a
+        // control and never release it — the tap looks dead.
+        for (window_id, point) in batch {
+            self.do_callback(XlibEvent::Touch(TouchUpdateEvent {
+                time,
+                window_id,
+                modifiers,
+                touches: vec![point],
+            }));
+        }
+    }
