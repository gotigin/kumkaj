+impl Dispatch<wl_touch::WlTouch, ()> for WaylandState {
+    fn event(
+        state: &mut Self,
+        _touch: &wl_touch::WlTouch,
+        event: wl_touch::Event,
+        _: &(),
+        _conn: &Connection,
+        _qhandle: &QueueHandle<Self>,
+    ) {
+        match event {
+            wl_touch::Event::Down {
+                serial,
+                time: _,
+                surface,
+                id,
+                x,
+                y,
+            } => {
+                let Some(window_id) = state.window_id_for_surface(&surface) else {
+                    return;
+                };
+                let pos = dvec2(x as f64, y as f64);
+                state.last_mouse_pos = pos;
+                state.note_finger(pos);
+                state.dismiss_popups_on_main_window(window_id);
+                if state.shell_takes_touch(window_id, pos, serial, id) {
+                    return;
+                }
+                state.touch_points.push(WaylandTouch { id, window_id, pos });
+                state.queue_touch(window_id, id, pos, TouchState::Start);
+            }
+            wl_touch::Event::Motion {
+                time: _,
+                id,
+                x,
+                y,
+            } => {
+                let pos = dvec2(x as f64, y as f64);
+                state.last_mouse_pos = pos;
+                state.note_finger(pos);
+                if state.caption_touch == Some(id) {
+                    state.drag_caption_if_moved(pos);
+                    return;
+                }
+                let window_id = {
+                    let Some(point) = state.touch_points.iter_mut().find(|p| p.id == id) else {
+                        return;
+                    };
+                    point.pos = pos;
+                    point.window_id
+                };
+                state.queue_touch(window_id, id, pos, TouchState::Move);
+            }
+            wl_touch::Event::Up {
+                serial: _,
+                time: _,
+                id,
+            } => {
+                state.note_finger(state.last_mouse_pos);
+                if state.caption_touch == Some(id) {
+                    state.caption_touch = None;
+                    if let Some((_, wid, pos)) = state.pending_caption_move.take() {
+                        state.finish_caption_click(wid, pos);
+                    }
+                    return;
+                }
+                let Some(index) = state.touch_points.iter().position(|p| p.id == id) else {
+                    return;
+                };
+                let point = state.touch_points.remove(index);
+                state.note_finger(point.pos);
+                state.queue_touch(point.window_id, id, point.pos, TouchState::Stop);
+            }
+            wl_touch::Event::Frame => state.emit_touch_frame(),
+            wl_touch::Event::Cancel => {
+                let points = std::mem::take(&mut state.touch_points);
+                state.touch_frame.clear();
+                state.caption_touch = None;
+                state.pending_caption_move = None;
+                for point in points {
+                    state.queue_touch(point.window_id, point.id, point.pos, TouchState::Stop);
+                }
+                state.emit_touch_frame();
+            }
+            _ => {}
         }
     }
 }
