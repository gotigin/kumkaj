+/// Writes `data` to a Storage Access Framework `content://` URI (one the
+/// save-file picker returned) through `MakepadActivity.writeContentUri`,
+/// replacing what was there. True when every byte was written.
+pub unsafe fn to_java_write_content_uri(uri: String, data: &[u8]) -> bool {
+    let env = attach_jni_env();
+    let Ok(uri) = CString::new(uri) else {
+        return false;
+    };
+    let uri = ((**env).NewStringUTF.unwrap())(env, uri.as_ptr());
+    let bytes = (**env).NewByteArray.unwrap()(env, data.len() as i32);
+    if bytes.is_null() {
+        return false;
+    }
+    (**env).SetByteArrayRegion.unwrap()(env, bytes, 0, data.len() as i32, data.as_ptr() as *const jni_sys::jbyte);
+    let ok = ndk_utils::call_bool_method!(
+        env,
+        get_activity(),
+        "writeContentUri",
+        "(Ljava/lang/String;[B)Z",
+        uri,
+        bytes
+    );
+    ok != 0
+}
