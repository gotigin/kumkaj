+    /// Page / Home / End / line scroll for a selectable document ScrollYView.
+    fn scroll_doc_viewport(&mut self, cx: &mut Cx, kind: DocScrollKind) {
+        let Some(scroll_bars) = self.scroll_bars_obj.as_mut() else {
+            return;
+        };
+        let pos = scroll_bars.get_scroll_pos();
+        let visible = scroll_bars.get_scroll_view_visible();
+        let total = scroll_bars.get_scroll_view_total();
+        let max_y = (total.y - visible.y).max(0.0);
+        let line = 48.0;
+        let page = (visible.y * 0.9).max(line);
+        let new_y = match kind {
+            DocScrollKind::PageUp => (pos.y - page).max(0.0),
+            DocScrollKind::PageDown => (pos.y + page).min(max_y),
+            DocScrollKind::Home => 0.0,
+            DocScrollKind::End => max_y,
+            DocScrollKind::LineUp => (pos.y - line).max(0.0),
+            DocScrollKind::LineDown => (pos.y + line).min(max_y),
+        };
+        if (new_y - pos.y).abs() > 0.5 {
+            scroll_bars.set_scroll_pos(cx, dvec2(pos.x, new_y));
+            self.area.redraw(cx);
+        }
+    }
