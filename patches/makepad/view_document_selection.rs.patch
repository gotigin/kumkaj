+    fn update_doc_leaf_selections(&self, cx: &mut Cx, leaves: &[WidgetRef]) {
+        let Some((start, end)) = self.doc_selection_range() else {
+            for leaf in leaves {
+                leaf.selection_clear();
+                leaf.redraw(cx);
+            }
+            return;
+        };
+        for (i, leaf) in leaves.iter().enumerate() {
+            if i < start.0 || i > end.0 {
+                leaf.selection_clear();
+            } else if i == start.0 && i == end.0 {
+                leaf.selection_set(start.1, end.1);
+            } else if i == start.0 {
+                let len = leaf.selection_text_len();
+                leaf.selection_set(start.1, len);
+            } else if i == end.0 {
+                leaf.selection_set(0, end.1);
+            } else {
+                leaf.selection_select_all();
+            }
+            leaf.redraw(cx);
+        }
+        self.area.redraw(cx);
+    }
