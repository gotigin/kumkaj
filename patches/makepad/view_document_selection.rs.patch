+        // 1. Direct hits (may be several when columns overlap in y).
+        let mut hit_idxs: Vec<usize> = Vec::new();
+        for (i, leaf) in leaves.iter().enumerate() {
+            if let Some(rect) = Self::leaf_rect(cx, leaf) {
+                if rect.contains(abs) {
+                    hit_idxs.push(i);
+                }
+            }
+        }
+        if let Some(i) = self.pick_column_leaf(cx, abs, leaves, &hit_idxs, prefer_near) {
+            let rect = Self::leaf_rect(cx, &leaves[i]).unwrap();
+            return Some((i, self.char_index_in_leaf(cx, abs, &leaves[i], rect)));
+        }
