+    fn doc_selection_range(&self) -> Option<((usize, usize), (usize, usize))> {
+        let a = self.selection_anchor?;
+        let c = self.selection_cursor?;
+        if (a.0, a.1) <= (c.0, c.1) {
+            Some((a, c))
