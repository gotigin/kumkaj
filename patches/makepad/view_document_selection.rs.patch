+        for i in start.0..=end.0 {
+            let Some(leaf) = leaves.get(i) else {
+                continue;
+            };
+            let text = if i == start.0 && i == end.0 {
+                leaf.selection_get_text_for_range(start.1, end.1)
+            } else if i == start.0 {
+                leaf.selection_get_text_for_range(start.1, leaf.selection_text_len())
+            } else if i == end.0 {
+                leaf.selection_get_text_for_range(0, end.1)
+            } else {
+                leaf.selection_get_full_text()
+            };
