+        abs: DVec2,
+        leaves: &[WidgetRef],
+        prefer_near: Option<usize>,
+    ) -> Option<(usize, usize)> {
+        if leaves.is_empty() {
+            return None;
+        }
+        let view_rect = self.area.rect(cx);
+        if abs.y < view_rect.pos.y {
+            return Some((0, 0));
+        }
+        if abs.y > view_rect.pos.y + view_rect.size.y {
+            let last = leaves.len() - 1;
+            return Some((last, leaves[last].selection_text_len()));
+        }
