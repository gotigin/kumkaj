+        // 2. Same vertical band — pick by column (x), then snap to edge.
+        let mut band_idxs: Vec<usize> = Vec::new();
+        for (i, leaf) in leaves.iter().enumerate() {
+            if let Some(rect) = Self::leaf_rect(cx, leaf) {
