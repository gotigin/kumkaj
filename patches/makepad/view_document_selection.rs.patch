+            let top = rect.pos.y;
+            let bottom = top + rect.size.y;
+            if bottom <= abs.y {
+                if above.is_none() || bottom > above.unwrap().1 {
+                    above = Some((i, bottom));
+                }
+            } else if top >= abs.y {
+                if below.is_none() || top < below.unwrap().1 {
+                    below = Some((i, top));
+                }
+            }
+        }
+        match (above, below) {
