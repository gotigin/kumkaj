+        // 3. Gap: only consider leaves in the pointer's column (horizontally
+        // near). Stops the floor card from owning gaps in the left copy.
+        let mut col_idxs: Vec<usize> = Vec::new();
+        let mut best_dx = f64::MAX;
+        for (i, leaf) in leaves.iter().enumerate() {
+            if let Some(rect) = Self::leaf_rect(cx, leaf) {
+                let dx = Self::horiz_dist_to_rect(abs, rect);
+                if dx < best_dx {
+                    best_dx = dx;
+                }
+                let _ = i;
+            }
+        }
