+/// The press that began on this widget was taken over by a container (a
+/// scroll view started scrolling, a list started a drag). It ended without a
+/// click: drop the pressed look and any armed press state. Never a tap.
+#[derive(Clone, Debug)]
+pub struct FingerCancelEvent {
+    pub window_id: WindowId,
+    /// Where the finger is now.
+    pub abs: Vec2d,
+    /// Where the press began.
+    pub abs_start: Vec2d,
+    /// When the press began.
+    pub capture_time: f64,
+    pub time: f64,
+    pub digit_id: DigitId,
+    pub device: DigitDevice,
+}
+impl Deref for FingerCancelEvent {
+    type Target = DigitDevice;
+    fn deref(&self) -> &DigitDevice {
+        &self.device
+    }
+}
