+    /// After an explicit scroll during drag-select, extend under the held pointer.
+    fn doc_select_follow_pointer(&mut self, cx: &mut Cx) {
+        if !(self.is_selecting && self.selection_committed) {
+            return;
+        }
+        let leaves = self.collect_selectable_leaves(cx);
+        let prefer = self.selection_cursor.map(|c| c.0);
+        if let Some(hit) =
+            self.hit_test_doc_selection_near(cx, self.select_last_abs, &leaves, prefer)
+        {
+            if self.selection_cursor != Some(hit) {
+                self.selection_cursor = Some(hit);
+                self.update_doc_leaf_selections(cx, &leaves);
+            }
+        }
+    }
+
+    /// Apply a wheel/trackpad delta while drag-select owns an Empty scroll-block
+    /// (ScrollBars refuse the event). Same sign as ScrollBar: `pos + scroll`.
+    fn doc_select_apply_wheel(&mut self, cx: &mut Cx, scroll: DVec2) -> bool {
+        let Some(scroll_bars) = self.scroll_bars_obj.as_mut() else {
+            return false;
+        };
+        let pos = scroll_bars.get_scroll_pos();
+        let visible = scroll_bars.get_scroll_view_visible();
+        let total = scroll_bars.get_scroll_view_total();
+        let max_y = (total.y - visible.y).max(0.0);
+        let max_x = (total.x - visible.x).max(0.0);
+        let new = dvec2(
+            (pos.x + scroll.x).clamp(0.0, max_x),
+            (pos.y + scroll.y).clamp(0.0, max_y),
+        );
+        if (new - pos).length() <= 0.5 {
+            return false;
+        }
+        scroll_bars.set_scroll_pos(cx, new);
+        self.area.redraw(cx);
+        true
+    }
+
