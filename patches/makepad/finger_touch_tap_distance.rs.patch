 //       See Android's ViewConfiguration.getLongPressTimeout().
 pub const TAP_COUNT_TIME: f64 = 0.5;
 pub const TAP_COUNT_DISTANCE: f64 = 5.0;
+/// How far a finger may drift and still be a tap. A mouse stays at
+/// `TAP_COUNT_DISTANCE`. A finger always jitters, and a scrolling page
+/// does not take the gesture until 8px, so a 6px touch was neither a tap
+/// nor a scroll — the control looked dead.
+pub const TOUCH_TAP_DISTANCE: f64 = 24.0;
 
