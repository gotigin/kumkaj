+    /// Drop the shift to 0 at once and forget the keyboard. Kumkaj: every
+    /// hide path snaps instead of easing through `NextFrame`. On Android
+    /// (Huawei AGS2 / API 26) the eased close stalled mid-shift and left the
+    /// window clear colour as a beige strip with clipped fields. The keyboard
+    /// is already gone when the hide arrives, so there is nothing to track.
+    fn snap_closed(&mut self, cx: &mut Cx) {
+        self.set_keyboard_shift(cx, 0.0);
+        self.anim_state = AnimState::Closed;
+        self.keyboard_height = 0.0;
+        self.last_reconciled_keyboard_height = 0.0;
+        self.redraw(cx);
+    }
