+// `GetMessageExtraInfo` is not in the vendored `windows` bindings.
+#[inline]
+unsafe fn GetMessageExtraInfo() -> LPARAM {
+    windows_core::link!("user32.dll" "system" fn GetMessageExtraInfo() -> isize);
+    unsafe { LPARAM(GetMessageExtraInfo()) }
+}
+
+/// Windows stamps this on WM_MOUSE* that it synthesized from a finger or
+/// pen. A real mouse message never carries it.
+fn message_from_touch() -> bool {
+    const TOUCH_OR_PEN: isize = 0xFF515700;
+    unsafe { (GetMessageExtraInfo().0 & 0xFFFFFF00) == TOUCH_OR_PEN }
+}
