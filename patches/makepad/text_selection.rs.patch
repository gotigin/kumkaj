+            Event::MouseDown(me) if self.selection_root_contains(cx, me.abs) => {
+                if self.root_handles {
+                    self.root_handles = false;
+                    self.redraw(cx);
+                }
+                if me.button.is_secondary() {
+                    // Copy / Select all on text, or anywhere while a page-wide or
+                    // cross-block selection is up — never for a right-click on a
+                    // button, field or tappable card (that is not about copy).
+                    let on_text = self
+                        .selection_root_leaves(cx)
+                        .iter()
+                        .any(|l| l.area().clipped_rect(cx).contains(me.abs));
+                    let has_page_selection = self.root_select_all || !self.root_cross.is_empty();
+                    if !self.selection_root_point_on_control(cx, me.abs)
