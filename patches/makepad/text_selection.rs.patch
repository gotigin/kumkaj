+/// Selection root (Kumkaj `text_selection` patch; DESIGN.md § Text selection
+/// & copy). Blocks keep their own pointer selection; the root only owns what
+/// spans blocks. No cross-block drag: that host left some cards dead before.
+impl View {
+    fn selection_root_contains(&self, cx: &Cx, abs: DVec2) -> bool {
+        self.visible && self.area.is_valid(cx) && self.area.clipped_rect(cx).contains(abs)
+    }
+
+    fn collect_selection_leaves_into(w: &WidgetRef, out: &mut Vec<WidgetRef>) {
+        if !w.visible() {
+            return;
+        }
+        if w.selection_leaf() {
+            out.push(w.clone());
+            return;
+        }
+        // Buttons / fields / links: their faces are not copy.
+        if w.steals_document_selection() {
+            return;
+        }
+        w.children(&mut |_id, child| Self::collect_selection_leaves_into(&child, out));
+    }
+
+    /// Selectable text blocks on screen under this root, in tree (reading)
+    /// order. Hidden subtrees and blocks not drawn in the last frame are out.
+    pub fn selection_root_leaves(&self, cx: &Cx) -> Vec<WidgetRef> {
+        let mut out = Vec::new();
+        for (_id, child) in &self.children {
+            Self::collect_selection_leaves_into(child, &mut out);
+        }
+        out.retain(|w| w.area().is_valid(cx));
+        out
+    }
+
+    /// Ctrl/Cmd+A: every selectable block this root shows.
+    pub fn selection_root_select_all(&mut self, cx: &mut Cx) {
+        for leaf in self.selection_root_leaves(cx) {
+            leaf.selection_select_all();
+            leaf.redraw(cx);
+        }
+        self.root_select_all = true;
+        // From a finger selection's bar / menu: it comes back over the new
+        // selection so Copy stays one tap away (Chrome keeps its bar). It
+        // used to close and leave Select all with no way to copy by touch.
+        if self.root_handles {
+            self.redraw(cx);
+            self.selection_root_touch_menu(cx);
+        }
+    }
+
+    /// Drop a page-wide Select all or a drag that spanned blocks (a block's
+    /// own single-block selection clears with its key focus).
+    pub fn selection_root_clear(&mut self, cx: &mut Cx) {
+        for (leaf, _, _) in self.root_cross.drain(..) {
+            leaf.selection_clear();
+            leaf.redraw(cx);
+        }
+        if !self.root_select_all {
+            return;
+        }
+        self.root_select_all = false;
+        let mut leaves = Vec::new();
+        for (_id, child) in &self.children {
+            Self::collect_selection_leaves_into(child, &mut leaves);
+        }
+        for leaf in leaves {
+            leaf.selection_clear();
+            leaf.redraw(cx);
+        }
+    }
+
+    pub fn selection_root_is_all(&self) -> bool {
+        self.root_select_all
+    }
+
+    /// Every selected block's text after Select all, blocks joined by newlines.
+    pub fn selection_root_all_text(&self, cx: &Cx) -> String {
+        let mut out = String::new();
+        for leaf in self.selection_root_leaves(cx) {
+            let t = leaf.selection_get_full_text();
+            let t = t.trim();
+            if t.is_empty() {
+                continue;
+            }
+            if !out.is_empty() {
+                out.push('\n');
+            }
+            out.push_str(t);
+        }
+        out
+    }
+
+    /// A text field (under this root or anywhere: the IME rect follows the
+    /// focused field) owns Ctrl+A / Copy — the root leaves them alone.
+    fn selection_root_field_owns_keys(&self, cx: &Cx) -> bool {
+        let focus = cx.key_focus();
+        if focus == Area::Empty {
+            return false;
+        }
+        let ime = cx.get_ime_area_rect();
+        if ime.size.y > 0.0 && focus.is_valid(cx) && focus.rect(cx) == ime {
+            return true;
+        }
+        fn visit(w: &WidgetRef, cx: &Cx, owns: &mut bool) {
+            if *owns || !w.visible() {
+                return;
+            }
+            if w.borrow::<TextInput>().is_some() && w.key_focus(cx) {
+                *owns = true;
+                return;
+            }
+            w.children(&mut |_, child| visit(&child, cx, owns));
+        }
+        let mut owns = false;
+        for (_id, child) in &self.children {
+            visit(child, cx, &mut owns);
+        }
+        owns
+    }
+
+    fn selection_root_before_children(&mut self, cx: &mut Cx, event: &Event) {
+        if !self.visible {
