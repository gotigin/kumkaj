+        let mut last = None;
+        for leaf in self.selection_root_leaves(cx) {
+            if let Some((start, end, r0, r1)) = leaf.selection_ends(cx) {
+                if first.is_none() {
+                    first = Some((leaf.clone(), start, r0));
+                }
+                last = Some((leaf, end, r1));
+            }
+        }
+        Some((first?, last?))
+    }
+
+    /// Text point each end sits on: the start's left edge and the end's right
+    /// edge, at mid line height.
+    fn selection_handle_points(r0: Rect, r1: Rect) -> (DVec2, DVec2) {
+        (
+            dvec2(r0.pos.x, r0.pos.y + r0.size.y * 0.5),
+            dvec2(r1.pos.x + r1.size.x, r1.pos.y + r1.size.y * 0.5),
+        )
+    }
+
+    fn draw_selection_handles(&mut self, cx: &mut Cx2d) {
+        let Some(((_, _, r0), (_, _, r1))) = self.selection_root_ends(cx) else {
+            self.root_handle_hits = None;
+            return;
+        };
+        let r = Self::SEL_HANDLE_R;
+        let mut hits = [Rect::default(); 2];
+        for (i, (x, top, bottom)) in [
+            (r0.pos.x, r0.pos.y, r0.pos.y + r0.size.y),
+            (r1.pos.x + r1.size.x, r1.pos.y, r1.pos.y + r1.size.y),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            // Stem along the selection edge, knob hanging under the line.
+            self.draw_sel_handle.draw_abs(
+                cx,
+                Rect { pos: dvec2(x - 1.0, top), size: dvec2(2.0, bottom - top + r) },
+            );
+            let knob = dvec2(x, bottom + r);
+            self.draw_sel_handle.draw_abs(
+                cx,
+                Rect { pos: dvec2(knob.x - r, knob.y - r), size: dvec2(2.0 * r, 2.0 * r) },
+            );
+            let h = Self::SEL_HANDLE_HIT;
+            hits[i] = Rect { pos: dvec2(knob.x - h, knob.y - h), size: dvec2(2.0 * h, 2.0 * h) };
+        }
+        self.root_handle_hits = Some((hits[0], hits[1]));
+    }
+
+    /// A finger on a knob: hold the other end and let this one follow.
+    fn selection_root_grab_handle(&mut self, cx: &mut Cx, abs: DVec2) -> bool {
+        let Some((h0, h1)) = self.root_handle_hits else {
+            return false;
+        };
+        let start_knob = h0.contains(abs);
+        if !start_knob && !h1.contains(abs) {
+            return false;
+        }
+        let Some(((l0, i0, r0), (l1, i1, r1))) = self.selection_root_ends(cx) else {
+            return false;
+        };
+        let (p0, p1) = Self::selection_handle_points(r0, r1);
+        let (anchor_leaf, anchor_idx, moving_point) = if start_knob {
+            (l1, i1, p0)
+        } else {
+            (l0, i0, p1)
+        };
+        // The other blocks' parts are rebuilt by the drag.
+        self.root_cross.clear();
+        self.root_gap = Some((anchor_leaf, anchor_idx, abs, true));
+        self.root_handle_offset = Some(moving_point - abs);
+        self.root_touch_start = None;
+        cx.block_scrolling_except_within(Area::Empty);
+        cx.hide_clipboard_actions();
+        true
+    }
+
+    /// End of a touch inside this root: finish a knob drag (menu again), show
+    /// the knobs after a finger selection, or clear everything on a tap.
+    fn selection_root_touch_end(&mut self, cx: &mut Cx, abs: DVec2) {
+        if self.root_handle_offset.take().is_some() {
+            if let Some((_, _, _, committed)) = self.root_gap.take() {
+                if committed {
+                    cx.unblock_scrolling();
+                }
+            }
+            self.selection_root_touch_menu(cx);
+            self.redraw(cx);
+            return;
+        }
+        if std::mem::take(&mut self.root_touch_sel) {
+            self.root_handles = true;
+            // The whole selection (it may run across blocks), not just the
+            // block the finger lifted in.
+            self.selection_root_touch_menu(cx);
+            self.redraw(cx);
+            return;
+        }
+        let Some(start) = self.root_touch_start.take() else {
+            return;
+        };
+        // A tap (not a scroll) anywhere else clears the selection, as in a
+        // browser; a swipe scrolls with the selection kept.
+        if (abs - start).length() <= 12.0 {
+            self.selection_root_touch_clear(cx);
+        }
+    }
+
+    /// Drop a finger selection everywhere: the blocks' parts and the knobs.
+    fn selection_root_touch_clear(&mut self, cx: &mut Cx) {
+        let had = self.root_handles || !self.root_cross.is_empty() || self.root_select_all;
+        self.selection_root_clear(cx);
+        if had {
+            for leaf in self.selection_root_leaves(cx) {
+                if leaf.selection_ends(cx).is_some() {
+                    leaf.selection_clear();
+                    leaf.redraw(cx);
+                }
+            }
+        }
+        if self.root_handles {
+            self.root_handles = false;
+            self.redraw(cx);
+        }
+    }
+
+    /// Copy / Select all for the selection after a knob drag: the OS bar on
+    /// Android / iOS, the app's own menu elsewhere (`TextSelectionAction`).
+    fn selection_root_touch_menu(&mut self, cx: &mut Cx) {
+        let Some(((_, _, r0), (_, _, r1))) = self.selection_root_ends(cx) else {
+            return;
+        };
+        let x0 = r0.pos.x.min(r1.pos.x);
+        let y0 = r0.pos.y.min(r1.pos.y);
+        let x1 = (r0.pos.x + r0.size.x).max(r1.pos.x + r1.size.x);
+        let y1 = (r0.pos.y + r0.size.y).max(r1.pos.y + r1.size.y);
+        let rect = Rect { pos: dvec2(x0, y0), size: dvec2(x1 - x0, y1 - y0) };
+        cx.show_read_only_clipboard_actions(rect, cx.keyboard_shift);
+        cx.widget_action(
+            self.widget_uid(),
+            TextSelectionAction::Menu { abs: rect.pos, touch: true, rect },
+        );
+    }
+
+    fn selection_root_extend(&mut self, cx: &mut Cx, abs: DVec2) {
+        // No live text drag anywhere: an ordinary move / scroll costs nothing
+        // (no walk over the blocks on every pointer event).
+        let gap_live = matches!(self.root_gap, Some((_, _, _, true)));
+        if !gap_live
+            && !crate::text_flow::SELECTION_DRAG_LIVE.load(std::sync::atomic::Ordering::Relaxed)
+        {
+            self.root_drag_abs = None;
+            self.root_autoscroll = 0.0;
+            return;
+        }
+        let leaves = self.selection_root_leaves(cx);
+        // The anchor: a block's own live drag, or a drag the root started in
+        // a gap (web pages). Gap drags are the root's from the first block.
+        let gap = match &self.root_gap {
+            Some((leaf, idx, _, true)) => leaves
+                .iter()
+                .position(|l| l.widget_uid() == leaf.widget_uid())
+                .map(|i| (i, *idx)),
+            _ => None,
+        };
+        let Some((from, anchor, own)) = gap.map(|(i, a)| (i, a, true)).or_else(|| {
+            leaves
+                .iter()
+                .enumerate()
+                .find_map(|(i, l)| l.selection_drag_anchor().map(|a| (i, a, false)))
+        }) else {
+            self.root_drag_abs = None;
+            self.root_autoscroll = 0.0;
+            return;
+        };
+        self.root_drag_abs = Some(abs);
+        self.selection_root_edge_scroll(cx, &leaves[from], abs);
+        let Some((to, idx)) = Self::selection_root_hit(cx, &leaves, abs) else {
+            return;
+        };
+        let mut next: Vec<(WidgetRef, usize, usize)> = Vec::new();
+        if to != from || own {
+            let (lo, hi) = if to > from { (from, to) } else { (to, from) };
+            for i in lo..=hi {
+                let leaf = &leaves[i];
+                let len = leaf.selection_text_len();
+                let (a, b) = if i == from && i == to {
+                    (anchor, idx)
+                } else if i == from {
+                    // Anchor block: keep its anchor first so its own drag goes on.
+                    if to > from { (anchor, len) } else { (anchor, 0) }
+                } else if i == to {
+                    if to > from { (0, idx) } else { (len, idx) }
+                } else {
+                    (0, len)
+                };
+                next.push((leaf.clone(), a, b));
+            }
+        }
+        // Blocks the span no longer covers (a block's own drag keeps its own).
+        for (old, _, _) in &self.root_cross {
+            let uid = old.widget_uid();
+            let still = next.iter().any(|(l, _, _)| l.widget_uid() == uid);
+            if !still && (own || leaves[from].widget_uid() != uid) {
+                old.selection_clear();
+                old.redraw(cx);
+            }
+        }
+        for (leaf, a, b) in &next {
+            leaf.selection_set(*a, *b);
+            leaf.redraw(cx);
+        }
+        self.root_cross = next
+            .into_iter()
+            .map(|(l, a, b)| (l, a.min(b), a.max(b)))
+            .collect();
+    }
+
+    /// Innermost scrolling View (ScrollYView, …) under this root that holds
+    /// `target`; `None` when only the root itself (or nothing) scrolls it.
+    fn selection_root_scroller_of(w: &WidgetRef, target: WidgetUid, stack: &mut Vec<WidgetRef>) -> Option<WidgetRef> {
+        if w.widget_uid() == target {
+            return stack.last().cloned();
+        }
+        let scrolls = w.borrow::<View>().is_some_and(|v| v.scroll_bars_obj.is_some());
+        if scrolls {
+            stack.push(w.clone());
+        }
+        let mut found = None;
+        w.children(&mut |_, child| {
+            if found.is_none() {
+                found = Self::selection_root_scroller_of(&child, target, stack);
+            }
+        });
+        if scrolls {
+            stack.pop();
+        }
+        found
+    }
+
+    fn selection_root_drag_leaf(&self, cx: &Cx) -> Option<WidgetRef> {
+        if let Some((leaf, _, _, true)) = &self.root_gap {
+            return Some(leaf.clone());
+        }
+        self.selection_root_leaves(cx)
+            .into_iter()
+            .find(|l| l.selection_drag_anchor().is_some())
+    }
+
+    /// Scroll the view the live drag is in by `dy` (wheel / edge auto-scroll).
+    fn selection_root_scroll_by(&mut self, cx: &mut Cx, dy: f64) -> bool {
+        if dy == 0.0 {
+            return false;
+        }
+        let Some(leaf) = self.selection_root_drag_leaf(cx) else {
+            return false;
+        };
+        let target = leaf.widget_uid();
+        let mut scroller = None;
+        for (_id, child) in &self.children {
+            scroller = Self::selection_root_scroller_of(child, target, &mut Vec::new());
+            if scroller.is_some() {
+                break;
+            }
+        }
+        let changed = if let Some(w) = scroller {
+            let changed = if let Some(mut v) = w.borrow_mut::<View>() {
+                match v.scroll_bars_obj.as_mut() {
+                    Some(sb) => {
+                        let pos = sb.get_scroll_pos();
+                        sb.set_scroll_pos(cx, pos + dvec2(0.0, dy))
+                    }
+                    None => false,
+                }
+            } else {
+                false
+            };
+            w.redraw(cx);
+            changed
+        } else if let Some(sb) = self.scroll_bars_obj.as_mut() {
+            let pos = sb.get_scroll_pos();
+            let changed = sb.set_scroll_pos(cx, pos + dvec2(0.0, dy));
+            cx.redraw_area_and_children(self.area);
+            changed
+        } else {
+            false
+        };
+        changed
+    }
+
+    /// Pointer past the top / bottom of the scroll view the drag is in: keep
+    /// scrolling a little every frame (faster the further out), like a browser.
+    fn selection_root_edge_scroll(&mut self, cx: &mut Cx, leaf: &WidgetRef, abs: DVec2) {
+        let target = leaf.widget_uid();
+        let mut rect = None;
+        for (_id, child) in &self.children {
+            if let Some(w) = Self::selection_root_scroller_of(child, target, &mut Vec::new()) {
+                rect = Some(w.area().clipped_rect(cx));
+                break;
+            }
+        }
+        let rect = match rect {
+            Some(r) => r,
+            None if self.scroll_bars_obj.is_some() => self.area.clipped_rect(cx),
+            None => {
+                self.root_autoscroll = 0.0;
+                return;
+            }
+        };
+        const EDGE: f64 = 24.0;
+        let top = rect.pos.y + EDGE;
+        let bottom = rect.pos.y + rect.size.y - EDGE;
+        let speed = if abs.y < top {
+            -((top - abs.y) * 0.5).clamp(2.0, 40.0)
+        } else if abs.y > bottom {
+            ((abs.y - bottom) * 0.5).clamp(2.0, 40.0)
+        } else {
+            0.0
+        };
+        let was = self.root_autoscroll;
+        self.root_autoscroll = speed;
+        if speed != 0.0 && was == 0.0 {
+            self.root_tick = cx.new_next_frame();
+        }
+    }
+
+    /// A button, field or link under the pointer (they never start a gap drag).
+    fn selection_root_point_on_control(&self, cx: &Cx, abs: DVec2) -> bool {
+        let mut hit = false;
+        for (_id, child) in &self.children {
+            child.find_widgets_from_point(cx, abs, &mut |w| {
+                if w.steals_document_selection() {
+                    hit = true;
+                }
+            });
+            if hit {
+                break;
+            }
+        }
+        hit
+    }
+
+    /// Text of a drag that spanned blocks, one block per line.
+    fn selection_root_cross_text(&self) -> String {
+        let mut out = String::new();
+        for (leaf, a, b) in &self.root_cross {
+            let t = leaf.selection_get_text_for_range(*a, *b);
+            let t = t.trim();
+            if t.is_empty() {
+                continue;
+            }
+            if !out.is_empty() {
+                out.push('\n');
+            }
+            out.push_str(t);
+        }
+        out
+    }
+}
