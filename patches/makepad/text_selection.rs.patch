+                    // from the nearest text, as a browser does.
+                    if self.select_from_gaps && me.button.is_primary() {
+                        let leaves = self.selection_root_leaves(cx);
+                        let on_text = leaves.iter().any(|l| l.area().rect(cx).contains(me.abs));
+                        if !on_text && !self.selection_root_point_on_control(cx, me.abs) {
+                            if let Some((i, idx)) = Self::selection_root_hit(cx, &leaves, me.abs) {
+                                self.root_gap = Some((leaves[i].clone(), idx, me.abs, false));
