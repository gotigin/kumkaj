-                ) {
-                    Ok(()) => break,
-                    Err(e) => {
-                        device = None;
-                        context = None;
-                        last_err = Some(e);
+
+            // Hardware adapter 0 first (normal desktops / laptops).
+            if let Ok(adapter) = factory.EnumAdapters(0) {
+                for &flags in &flag_sets {
+                    match D3D11CreateDevice(
+                        &adapter,
+                        D3D_DRIVER_TYPE_UNKNOWN,
+                        HMODULE(std::ptr::null_mut()),
+                        flags,
+                        Some(&feature_levels),
+                        D3D11_SDK_VERSION,
+                        Some(&mut device),
+                        None,
+                        Some(&mut context),
+                    ) {
+                        Ok(()) => break,
+                        Err(e) => {
+                            device = None;
+                            context = None;
+                            last_err = Some(e);
+                        }
                     }
                 }
             }
+
+            // QEMU/VMs and machines with a broken DXGI adapter: CPU WARP so the
+            // window still opens instead of dying in expect("D3D11…").
+            if device.is_none() {
+                for &flags in &flag_sets {
+                    match D3D11CreateDevice(
+                        None,
+                        D3D_DRIVER_TYPE(5i32), // WARP (CPU) — not re-exported by vendored windows-rs
+                        HMODULE(std::ptr::null_mut()),
+                        flags,
+                        Some(&feature_levels),
+                        D3D11_SDK_VERSION,
+                        Some(&mut device),
+                        None,
+                        Some(&mut context),
+                    ) {
+                        Ok(()) => break,
+                        Err(e) => {
+                            device = None;
+                            context = None;
+                            last_err = Some(e);
+                        }
+                    }
+                }
+            }
+
             if device.is_none() {
                 return Err(last_err.unwrap());
             }
