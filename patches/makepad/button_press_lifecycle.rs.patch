     #[action_data]
     #[rust]
     action_data: WidgetActionData,
+
+    /// Press lifecycle — see `begin_press` / `end_press`. The pressed face
+    /// follows the finger exactly: shown while held over the button, dropped
+    /// the moment the press ends any way at all (release, cancel by a
+    /// scrolling parent, finger dragged off, hidden or disabled mid-press,
+    /// capture lost). A face left "down" with nothing holding it was the
+    /// stuck/glitchy press seen on every touch screen.
+    #[rust]
+    pressed: bool,
+    /// The pressed face is currently painted for `pressed`.
+    #[rust]
+    down_shown: bool,
+    /// The finger is still on the face (within touch slop).
+    #[rust]
+    press_on_face: bool,
+    /// Touch: the pressed face waits ~80 ms (Android's tap timeout idea) so a
+    /// swipe that starts on a button scrolls without flashing it pressed.
+    #[rust]
+    press_timer: Timer,
+    /// The next key focus comes from a press, not the keyboard.
+    #[rust]
+    focus_by_pointer: bool,
+}
+
+/// How long a finger must rest on a button before it paints pressed. A tap
+/// that lifts sooner still flashes the pressed face on release.
+const TOUCH_PRESS_FACE_DELAY: f64 = 0.08;
+
+impl Button {
+    fn begin_press(&mut self, cx: &mut Cx, touch: bool) {
+        self.pressed = true;
+        self.press_on_face = true;
+        cx.stop_timer(self.press_timer);
+        if touch {
+            self.down_shown = false;
+            self.press_timer = cx.start_timeout(TOUCH_PRESS_FACE_DELAY);
+        } else {
+            self.down_shown = true;
+            self.animator_play(cx, ids!(hover.down));
+        }
+    }
+
+    /// End the press. `hover_after`: the pointer still hovers the face (a
+    /// mouse released over it). `cut_off`: snap to idle (a click on a
+    /// `reset_hover_on_click` face). `acknowledge`: a tap released before
+    /// the delayed touch face showed flashes it so the tap is visibly taken.
+    fn end_press(&mut self, cx: &mut Cx, hover_after: bool, cut_off: bool, acknowledge: bool) {
+        cx.stop_timer(self.press_timer);
+        self.press_timer = Timer::default();
+        let flash = acknowledge && self.pressed && !self.down_shown;
+        self.pressed = false;
+        self.down_shown = false;
+        if flash {
+            self.animator_cut(cx, ids!(hover.down));
+            self.animator_play(cx, ids!(hover.off));
+        } else if cut_off {
+            self.animator_cut(cx, ids!(hover.off));
+        } else if hover_after {
+            self.animator_play(cx, ids!(hover.on));
+        } else {
+            self.animator_play(cx, ids!(hover.off));
+        }
+    }
+
+    /// The press ended somewhere this button never heard about (hidden or
+    /// disabled mid-press, a release outside the window, a list that drew
+    /// it again for another row): nothing captures the face any more, so it
+    /// must not stay painted pressed.
+    fn heal_orphan_press(&mut self, cx: &mut Cx) {
+        if self.pressed && !cx.fingers.is_area_captured(self.draw_bg.area()) {
+            self.end_press(cx, false, true, false);
+        }
+    }
 }
 
