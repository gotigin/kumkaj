+/// Keeps the screen awake while `on` (`FLAG_KEEP_SCREEN_ON`, set on the UI
+/// thread by `MakepadActivity.keepScreenOn`): a device other devices depend
+/// on must not doze off and drop them.
+pub unsafe fn to_java_keep_screen_on(on: bool) {
+    let env = attach_jni_env();
+    ndk_utils::call_void_method!(env, get_activity(), "keepScreenOn", "(Z)V", on as i32);
+}
