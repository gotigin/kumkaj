+/// Opens the Android share sheet with plain text. `MakepadActivity.shareText`
+/// posts the Intent to the UI thread.
+pub unsafe fn to_java_share_text(content: String) {
+    let env = attach_jni_env();
+    let content = CString::new(content).unwrap_or_else(|_| CString::new("").unwrap());
+    let content = ((**env).NewStringUTF.unwrap())(env, content.as_ptr());
+    ndk_utils::call_void_method!(
+        env,
+        get_activity(),
+        "shareText",
+        "(Ljava/lang/String;)V",
+        content
+    );
+}
+
+/// Reads a Storage Access Framework `content://` URI into bytes via
+/// `MakepadActivity.readContentUri`. `None` when the provider cannot be opened.
+pub unsafe fn to_java_read_content_uri(uri: String) -> Option<Vec<u8>> {
+    let env = attach_jni_env();
+    let uri = CString::new(uri).ok()?;
+    let uri = ((**env).NewStringUTF.unwrap())(env, uri.as_ptr());
+    let result = ndk_utils::call_object_method!(
+        env,
+        get_activity(),
+        "readContentUri",
+        "(Ljava/lang/String;)[B",
+        uri
+    );
+    if result.is_null() {
+        return None;
+    }
+    let bytes = java_byte_array_to_vec(env, result);
+    if bytes.is_empty() { None } else { Some(bytes) }
+}
