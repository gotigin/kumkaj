+/// The base direction of one paragraph: right to left when it begins with a
+/// RIGHT-TO-LEFT MARK (U+200F) or ARABIC LETTER MARK (U+061C), left to right
+/// otherwise.
+///
+/// The bidi pass then orders a right-to-left paragraph's runs from the right:
+/// a Latin word or a number inside Arabic, Urdu or Hebrew copy keeps its place
+/// in the sentence, punctuation at either end stays with the words it belongs
+/// to, and the space that ends a wrapped row hangs at the row's left end.
+/// Every row of the paragraph keeps the direction, also a row that starts
+/// with a Latin word. Text without the mark keeps the left-to-right base it
+/// always had, so user data in a left-to-right interface (an Arabic name in an
+/// English list) is not reordered; copy in a right-to-left language opts in
+/// by starting each paragraph with the mark.
+fn paragraph_direction(paragraph: &str) -> shaper::Direction {
+    match paragraph.chars().next() {
+        Some('\u{200F}' | '\u{061C}') => shaper::Direction::Rtl,
+        _ => shaper::Direction::Ltr,
+    }
+}
