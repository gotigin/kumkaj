+    // -----------------------------------------------------------------------
+    // Paragraph direction: a paragraph that starts with a right-to-left mark
+    // is laid out right to left, on every one of its rows. The Latin test
+    // font has no Hebrew glyphs; the .notdef boxes it draws instead still
+    // carry their clusters, which is all the visual order needs.
+    // -----------------------------------------------------------------------
+
+    #[test]
+    fn a_leading_rtl_mark_lays_the_paragraph_out_right_to_left() {
+        use super::paragraph_direction;
+        use crate::text::shaper::Direction;
+        assert_eq!(paragraph_direction("\u{200F}abc"), Direction::Rtl);
+        assert_eq!(paragraph_direction("\u{061C}abc"), Direction::Rtl);
+        assert_eq!(paragraph_direction("אבג abc"), Direction::Ltr, "opt-in only");
+        assert_eq!(paragraph_direction(""), Direction::Ltr);
+
+        let mut layouter = real_font_layouter();
+        // Left-to-right base: the Latin word, read first, is on the left.
+        let ltr = wrapped_layout(&mut layouter, LATIN_FAMILY, "abc אבג", 500.0, None, false);
+        assert_eq!(ltr.rows[0].glyphs[0].cluster, 0);
+        // Right-to-left base: the Latin word, read first, is on the right, so
+        // the leftmost glyph is the Hebrew word's last letter.
+        let text = "\u{200F}abc אבג";
+        let rtl = wrapped_layout(&mut layouter, LATIN_FAMILY, text, 500.0, None, false);
+        assert_eq!(&text[rtl.rows[0].glyphs[0].cluster..], "ג");
+    }
+
+    #[test]
