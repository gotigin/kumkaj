+        let mut layouter = real_font_layouter();
+        // Row 1 holds the long Hebrew word; row 2 starts with a Latin word.
+        let first_row = "\u{200F}אבגדהוזחטיכלמנ";
+        let row_width = layouter
+            .get_or_layout(BorrowedLayoutParams {
+                text: first_row,
+                style: super::Style {
+                    font_family_id: LATIN_FAMILY.into(),
+                    font_size_in_pts: 12.0,
+                    color: None,
+                },
+                options: LayoutOptions::default(),
+            })
+            .size_in_lpxs
+            .width;
+        let text = format!("{first_row} abc דה");
+        let laidout =
+            wrapped_layout(&mut layouter, LATIN_FAMILY, &text, row_width + 1.0, None, false);
+        assert_eq!(laidout.rows.len(), 2);
+        let row = &laidout.rows[1];
+        assert!(row.text.starts_with("abc"), "row 2 is {:?}", &*row.text);
+        assert_eq!(&row.text[row.glyphs[0].cluster..], "ה", "row 2 runs right to left");
+    }
