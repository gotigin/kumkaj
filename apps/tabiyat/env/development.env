# Tabiyat — development / debug builds
# (cargo tabiyat-dev; android/windows dev scripts under apps/tabiyat/scripts/).
# Sourced by scripts; also read by build.rs via KUMKAJ_ENV=development.
KUMKAJ_ENV=development
KUMKAJ_APP_ID=shop.tabiyat.debug
KUMKAJ_APP_LABEL="Tabiyat Dev"
KUMKAJ_SHOW_SIZE_BADGE=1
