# Moklanjo — development / debug builds
# (cargo moklanjo-dev, cargo moklanjo-android-dev, cargo moklanjo-windows-dev).
# Sourced by scripts; also read by build.rs via KUMKAJ_ENV=development.
KUMKAJ_ENV=development
KUMKAJ_APP_ID=com.moklanjo.debug
KUMKAJ_APP_LABEL="Moklanjo Dev"
KUMKAJ_SHOW_SIZE_BADGE=1
