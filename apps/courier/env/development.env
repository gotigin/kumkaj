# Kumkaj Courier — development / debug builds
# (cargo courier-dev, cargo courier-android-dev, cargo courier-windows-dev).
# Sourced by scripts; also read by build.rs via KUMKAJ_ENV=development.
KUMKAJ_ENV=development
KUMKAJ_APP_ID=com.kumkaj.courier.debug
KUMKAJ_APP_LABEL="Kumkaj Courier Dev"
KUMKAJ_SHOW_SIZE_BADGE=1
