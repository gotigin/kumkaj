# Maintainer: Mearaj Bhagad <mearajbhagad@gmail.com>
# Source package. makepkg compiles Khaynjo on the machine that installs it.
# There is no prebuilt Linux binary: vendor/makepad is not in the git repo
# (scripts/setup-makepad.sh fetches that commit and applies patches/makepad),
# then cargo builds kumkaj-khaynjo. pkgver matches apps/khaynjo/Cargo.toml.
# Publish steps: apps/khaynjo/docs/PUBLISH_AUR.md
#
# shellcheck disable=SC2034
pkgname=khaynjo
pkgver=1.0.6
pkgrel=1
pkgdesc="Khaynjo — local-first restaurant operating system (tables, KOT, billing, books)"
arch=('x86_64')
url="https://khaynjo.com"
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'libglvnd')
makedepends=('git' 'cargo' 'rust' 'rsync' 'clang')
conflicts=('khaynjo-bin')
replaces=('khaynjo-bin')
options=('!lto')
# Tag v${pkgver} on the commit whose Cargo version is this pkgver.
source=("git+https://github.com/gotigin/kumkaj.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
  cd kumkaj
  ./scripts/setup-makepad.sh
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')" -p kumkaj-khaynjo
}

build() {
  cd kumkaj
  export KUMKAJ_ENV=production
  export MAKEPAD_PACKAGE_DIR=.
  local size
  for size in 32 64 128 256 512 1024; do
    export "MAKEPAD_APP_ICON_${size}=${srcdir}/kumkaj/apps/khaynjo/resources/icon_${size}.png"
  done
  export "MAKEPAD_APP_ICON_ICO=${srcdir}/kumkaj/apps/khaynjo/resources/icon.ico"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p kumkaj-khaynjo
}

package() {
  cd kumkaj
  local root="${pkgdir}/usr/lib/khaynjo"
  local res="$root/kumkaj_khaynjo/resources"

  install -d "$root/bin"
  install -Dm755 target/release/kumkaj-khaynjo "$root/bin/kumkaj-khaynjo"

  mkdir -p "$res"
  cp -a apps/khaynjo/resources/. "$res/"
  rm -rf "$res/android"
  [[ -f "$res/fonts/fa-solid-900.ttf" ]] || {
    echo "missing fa-solid-900.ttf in packaged resources" >&2
    exit 1
  }
  [[ -f "$res/fonts/NotoSans-Regular.ttf" ]] || {
    echo "missing NotoSans-Regular.ttf in packaged resources" >&2
    exit 1
  }

  mkdir -p "$root/assets"
  cp -a apps/khaynjo/assets/items "$root/assets/items"
  cp -a apps/khaynjo/assets/templates "$root/assets/templates"

  # Desktop launch must start in the package root. A symlink to the binary
  # leaves cwd as $HOME, so fonts and the menu shelf are not found.
  install -d "${pkgdir}/usr/bin"
  cat >"${pkgdir}/usr/bin/khaynjo" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd /usr/lib/khaynjo
export MAKEPAD_PACKAGE_DIR=.
exec /usr/lib/khaynjo/bin/kumkaj-khaynjo "\$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/khaynjo"
  ln -sf khaynjo "${pkgdir}/usr/bin/kumkaj-khaynjo"

  install -d "${pkgdir}/usr/share/applications"
  cat >"${pkgdir}/usr/share/applications/khaynjo.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Khaynjo
Comment=Restaurant operating system — floor, kitchen, billing, books
Exec=khaynjo
Icon=khaynjo
Categories=Office;Finance;
Terminal=false
StartupWMClass=kumkaj-khaynjo
EOF

  install -Dm644 apps/khaynjo/resources/icon_256.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/khaynjo.png"
}
