# Khaynjo — development / debug builds
# (cargo khaynjo-dev; android/windows dev scripts under apps/khaynjo/scripts/).
# Sourced by scripts; also read by build.rs via KUMKAJ_ENV=development.
KUMKAJ_ENV=development
KUMKAJ_APP_ID=com.khaynjo.debug
KUMKAJ_APP_LABEL="Khaynjo Dev"
KUMKAJ_SHOW_SIZE_BADGE=1
