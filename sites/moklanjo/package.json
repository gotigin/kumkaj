{
  "name": "moklanjo-site",
  "private": true,
  "description": "moklanjo.com — Firebase Analytics + Auth client for the Makepad site",
  "scripts": {
    "build:firebase": "esbuild client/firebase-init.js --bundle --format=iife --outfile=static/js/firebase-init.js --minify",
    "build:account": "esbuild client/account-app.js --bundle --format=iife --outfile=static/js/account.js --minify",
    "build": "npm run build:firebase && npm run build:account"
  },
  "dependencies": {
    "firebase": "^11.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
