# Kirano cloud only — never point at Moklanjo DB.
DATABASE_URL=postgres://kirano:kirano_dev@127.0.0.1:5435/kirano_cloud
FIREBASE_PROJECT_ID=kirano-shop
HOST=0.0.0.0
PORT=8082
RUST_LOG=info
# Local smoke only (Bearer dev:<uid>:<email>). NEVER set on AWS.
# DEV_AUTH_BYPASS=1

# ---- Billing (sandbox first) ----
# Dashboards: Chrome profile **MEARAJ (Gotigin)** — Stripe + Paddle.
# Docs: docs/BILLING_SANDBOX.md
BILLING_ENABLED=1
BILLING_MODE=sandbox
# mock | stripe | paddle  (mock works with no gateway keys)
BILLING_DEFAULT_PROVIDER=mock
BILLING_SUCCESS_URL=http://127.0.0.1:8013/account?billing=success
BILLING_CANCEL_URL=http://127.0.0.1:8013/account?billing=cancel
PUBLIC_API_BASE=http://127.0.0.1:8080

# Stripe test mode (sk_test_… / pk_test_… / whsec_…)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Paddle sandbox (API key contains _sdbx; client token starts with test_)
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=

