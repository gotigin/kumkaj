# Moklanjo cloud only — never point at Moklanjo DB.
DATABASE_URL=postgres://moklanjo:moklanjo_dev@127.0.0.1:5434/moklanjo_cloud
FIREBASE_PROJECT_ID=moklanjo-com
HOST=0.0.0.0
PORT=8081
RUST_LOG=info
# Local smoke only (Bearer dev:<uid>:<email>). NEVER set on AWS.
# DEV_AUTH_BYPASS=1

# ---- Billing (sandbox first) ----
# Dashboards: Chrome profile **MEARAJ (Gotigin)** — Paddle.
# Docs: docs/BILLING_SANDBOX.md
BILLING_ENABLED=1
BILLING_MODE=sandbox
# mock | paddle  (mock works with no gateway keys)
BILLING_DEFAULT_PROVIDER=mock
# Local unpaid mock only — never set on AWS
# BILLING_ALLOW_MOCK=1
BILLING_SUCCESS_URL=http://127.0.0.1:8011/account?billing=success
BILLING_CANCEL_URL=http://127.0.0.1:8011/account?billing=cancel
PUBLIC_API_BASE=http://127.0.0.1:8080


# Paddle sandbox (API key contains _sdbx; client token starts with test_)
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=


# Product confirmation email (SES) — each product sends its own mail
MAIL_ENABLED=0
# MAIL_FROM=noreply@…
# MAIL_PRODUCT_NAME=…
# MAIL_ACCOUNT_URL=https://…/account
