# Khaynjo cloud only — never point at Moklanjo DB.
DATABASE_URL=postgres://khaynjo:khaynjo_dev@127.0.0.1:5433/khaynjo_cloud
FIREBASE_PROJECT_ID=khaynjo-2b2a2
HOST=0.0.0.0
PORT=8080
RUST_LOG=info
# Local smoke only (Bearer dev:<uid>:<email>). NEVER set on AWS.
# DEV_AUTH_BYPASS=1

# ---- Billing (sandbox first) ----
# Dashboards: Chrome profile **MEARAJ (Gotigin)** — Stripe + Paddle.
# Docs: docs/BILLING_SANDBOX.md
BILLING_ENABLED=1
BILLING_MODE=sandbox
# mock | stripe | paddle  (mock works with no gateway keys)
BILLING_DEFAULT_PROVIDER=mock
BILLING_SUCCESS_URL=http://127.0.0.1:8012/account?billing=success
BILLING_CANCEL_URL=http://127.0.0.1:8012/account?billing=cancel
PUBLIC_API_BASE=http://127.0.0.1:8080

# Stripe Test: restricted rk_test_… in .env.development as STRIPE_SECRET_KEY (not sk_/pk_/rk_live_)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Paddle sandbox (API key contains _sdbx; client token starts with test_)
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=

