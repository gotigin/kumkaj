# Khaynjo cloud only — never point at Moklanjo DB.
DATABASE_URL=postgres://khaynjo:khaynjo_dev@127.0.0.1:5433/khaynjo_cloud
FIREBASE_PROJECT_ID=khaynjo-2b2a2
HOST=0.0.0.0
PORT=8080
RUST_LOG=info
# API-only local smoke (Bearer dev:<uid>:<email>). NEVER on AWS / account UI.
# DEV_AUTH_BYPASS=1
# Local isolated E2E (Auth Emulator). NEVER on AWS.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- Billing (sandbox first) ----
# Dashboards: Chrome profile **MEARAJ (Gotigin)** — Paddle.
# Modes: docs/BILLING_SANDBOX.md — do not mix Auth Emulator with production Auth.
BILLING_ENABLED=1
BILLING_MODE=sandbox
# mock | paddle  (mock works with no gateway keys)
BILLING_DEFAULT_PROVIDER=mock
# Local unpaid mock only — never set on AWS
# BILLING_ALLOW_MOCK=1
BILLING_SUCCESS_URL=http://127.0.0.1:8012/account?billing=success
BILLING_CANCEL_URL=http://127.0.0.1:8012/account?billing=cancel
PUBLIC_API_BASE=http://127.0.0.1:8080


# Paddle sandbox (API key contains _sdbx; client token starts with test_)
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_NTF_LOCAL_ID=       # tunnel destination for local-paddle-e2e.sh
# PADDLE_NTF_DEPLOYED_ID=    # api.khaynjo.com sandbox destination


# Product confirmation email (SES) — each product sends its own mail
MAIL_ENABLED=0
# MAIL_FROM=noreply@…
# MAIL_PRODUCT_NAME=…
# MAIL_ACCOUNT_URL=https://…/account
